# ------------------------------------------------------------------------------
# Verdict — copy to `.env.local` and fill with your project values.
# ------------------------------------------------------------------------------

# PostgreSQL connection string (app user — created by `npm run db:create`)
DATABASE_URL=postgresql://reviewmax:reviewmax@localhost:5432/reviewmax

# One-time local setup: postgres superuser URL for `npm run db:create`
# Replace YOUR_POSTGRES_PASSWORD with the password you chose when installing PostgreSQL.
POSTGRES_ADMIN_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/postgres

# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET=replace_with_a_long_random_string
AUTH_URL=http://localhost:3000

# Seeded admin account (used by `npm run db:seed` only)
ADMIN_EMAIL=admin@reviewmax.local
ADMIN_INITIAL_PASSWORD=change-me-on-first-login

# Analytics & monitoring (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Canonical site URL for Open Graph, sitemap, and RSS
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact email shown on /contact (mailto link)
NEXT_PUBLIC_CONTACT_EMAIL=hello@verdict.reviews

# Amazon Associates tracking ID appended to buy links when missing ?tag=
NEXT_PUBLIC_AMAZON_TRACKING_ID=yourstore-20

# OpenAI — required to generate review drafts from /dashboard/new-review and
# to power the AI Review Assistant in the post editor.
OPENAI_API_KEY=

# Resend (email) — optional; enables welcome emails and newsletter sends from /dashboard/newsletter
# Get your API key at https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=Verdict <newsletter@yourdomain.com>
